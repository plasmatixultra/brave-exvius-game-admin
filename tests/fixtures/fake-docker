#!/bin/sh
# Test double for the docker CLI: records argv, answers inspect/status from fixtures.
printf '%s\n' "$*" >> "${CALLS_FILE:-/dev/null}"
case "$1" in
  inspect)
    if [ "$2" = "nosuch" ]; then
      echo "Error: No such object: nosuch" >&2
      exit 1
    fi
    cat "${FAKE_INSPECT_JSON:-$(dirname "$0")/docker_inspect_standard.json}"
    ;;
  exec)
    COUNTER="${CALLS_FILE:-/dev/null}.status"
    if [ -n "${FAKE_STATUS_FAILURES:-}" ]; then
      n=$(( $(cat "$COUNTER" 2>/dev/null || echo 0) + 1 ))
      echo "$n" > "$COUNTER"
      if [ "$n" -le "$FAKE_STATUS_FAILURES" ]; then
        echo "the server is not answering (connection refused)" >&2
        exit 1
      fi
    fi
    case "$*" in
      *" cat "*)
        [ -n "${FAKE_CAT:-}" ] || FAKE_CAT='{}'
        printf '%s\n' "$FAKE_CAT"
        exit 0 ;;
    esac
    if [ -n "${FAKE_STATUS_BAD:-}" ]; then
      echo '{"has_save": false, "name": null, "rank": -1, "roster": 0}'
    else
      echo '{"has_save": true, "name": "Rain", "rank": 3, "roster": 44}'
    fi
    ;;
  stop)
    if [ "$2" = "missing" ]; then
      echo "Error response from daemon: No such container: missing" >&2
      exit 1
    fi
    echo "$2"
    ;;
  start)
    if [ -n "${FAKE_START_FAILS:-}" ]; then
      echo "Error response from daemon: cannot start container: port is already allocated" >&2
      exit 1
    fi
    echo "$2"
    ;;
  run)
    # The engine export runs `sh -c` with the cache mounted at /cache: do what it
    # says, so the host sees the tree the real container would have written.
    case "$*" in
      *"--entrypoint sh"*|*"cp -a /app/server/. /cache/engine.new/"*)
        if [ -n "${FAKE_NO_SERVER:-}" ]; then
          echo "cp: cannot stat '/app/server': No such file or directory" >&2
          exit 1
        fi
        CACHE_HOST="$(printf '%s\n' "$*" | sed -n 's|.*[[:space:]]-v \([^ ]*\):/cache:rw.*|\1|p')"
        ID="$(printf '%s\n' "$*" | sed -n 's|.*IMAGE_ID=\([^ ]*\).*|\1|p')"
        if [ -z "$CACHE_HOST" ]; then
          echo "fake docker: no cache mount in: $*" >&2
          exit 1
        fi
        mkdir -p "$CACHE_HOST/engine.new"
        for name in player_state.py ffbe_state.py ffbe_battle.py first_clear.py mission_gil.py story_units.py; do
          printf '# exported stub\n' > "$CACHE_HOST/engine.new/$name"
        done
        printf '%s' "$ID" > "$CACHE_HOST/engine.new/.image-id"
        if [ -d "$CACHE_HOST/engine" ]; then
          find "$CACHE_HOST/engine" -mindepth 1 -delete
          rmdir "$CACHE_HOST/engine"
        fi
        mv "$CACHE_HOST/engine.new" "$CACHE_HOST/engine"
        exit 0 ;;
    esac
    # Behave like the image would: whatever host dir is mounted at /work gets the
    # files the real apply-files.sh writes there.
    WORK_HOST="$(printf '%s\n' "$*" | sed -n 's|.*[[:space:]]-v \([^ ]*\):/work:rw.*|\1|p')"
    case "$*" in
      *"--entrypoint cat"*)
        [ -n "${FAKE_CAT:-}" ] || FAKE_CAT='{}'
        printf '%s\n' "$FAKE_CAT" ;;
      *"apply-files.sh backup"*)
        echo "apply-files: backup ${FAKE_BACKUP:-/tmp/fake-backup.json}"
        if [ -d "$WORK_HOST" ]; then
          echo '{"name": "Rain", "rank": 3, "roster": 44}' > "$WORK_HOST/identity.json"
          echo '{"roster": []}' > "$WORK_HOST/save.json"
          echo "${FAKE_BACKUP:-/tmp/fake-backup.json}" > "$WORK_HOST/backup"
        fi ;;
      *"apply-files.sh apply"*)
        if [ -n "${FAKE_AGENT_FAILS:-}" ]; then
          echo "apply-files: the agent refused the edits" >&2
          exit 2
        fi
        echo "apply-files: staged 4096 bytes"
        if [ -d "$WORK_HOST" ]; then
          printf '{"roster": [%s]}\n' "$(seq -s, 1 44 | sed 's/[0-9]\+/{"id": &}/g')" > "$WORK_HOST/staging.json"
        fi ;;
      *"apply-files.sh validate"*)
        if [ -n "${FAKE_VALIDATE_FAILS:-}" ]; then exit 2; fi
        echo "apply-files: validated" ;;
      *"apply-files.sh write"*)
        echo "apply-files: save replaced" ;;
      *"apply-files.sh restore"*)
        echo "apply-files: save restored" ;;
      *)
        echo "apply complete" ;;
    esac
    ;;
  *)
    echo "fake docker: unsupported: $*" >&2
    exit 1
    ;;
esac
